# LIFORA - Backend Production & Development Environment Configuration
# Tagline: Your Life. Your Space. Your Rules.

# Application Environment ('production' | 'development')
ENVIRONMENT=development
APP_ENV=development
PROJECT_NAME="LIFORA"
API_V1_STR="/api/v1"

# Database Connections (PostgreSQL)
# On Render, DATABASE_URL is provided automatically by linking the Managed PostgreSQL database.
# Internal Render connection string (preferred): postgres://lifora_user:<PASSWORD>@dpg-<ID>-a/lifora_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fitpulse_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fitpulse_db

# Security & Authentication (Argon2id + JWT)
# Generate a secure 64-char key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-32-character-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Public URLs & CORS Origins
# In production on Render, set FRONTEND_URL to your deployed static site domain:
FRONTEND_URL=https://lifora.onrender.com
CORS_ORIGINS=["https://lifora.onrender.com","http://localhost:5173"]

# API Documentation Control
# Disabled by default in production for security. Set to true to inspect OpenAPI docs.
ENABLE_DOCS=false

# SMTP / Production Email Verification & Password Reset (Optional)
# If left empty, verification tokens are logged to server console in dev. In production, configure an SMTP provider:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="noreply@lifora.app"
SMTP_TLS=true

# AI Integration (Optional)
# Supported providers: openai, gemini, etc.
# If unconfigured, LIFORA runs deterministically without errors.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Cloud Object Storage (S3-compatible, Optional for persistent uploads across deploys)
# Compatible with AWS S3, Cloudflare R2, Wasabi, MinIO
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
