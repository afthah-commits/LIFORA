# LIFORA - Frontend Environment Configuration

# Production Backend API URL (Render Static Site Environment Variable)
# In production on Render, set VITE_API_BASE_URL to your deployed backend URL:
# Example: https://lifora-backend.onrender.com
VITE_API_BASE_URL=https://lifora-backend.onrender.com

# Local Development / LAN Access (Uses Vite dev proxy)
VITE_API_URL=/api/v1
