# LIFORA Production & Development Environment Configuration
# Tagline: Your Life. Your Space. Your Rules.

# Application Environment ('production' | 'development')
ENVIRONMENT=development
APP_ENV=development
PROJECT_NAME="LIFORA"
API_V1_STR="/api/v1"

# Database Connections (PostgreSQL)
# Local Windows PostgreSQL installation:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fitpulse_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fitpulse_db

# Security & Authentication (Argon2id + JWT)
SECRET_KEY=change-this-to-a-secure-random-32-character-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Public URLs & CORS Origins
FRONTEND_URL=https://lifora.onrender.com
CORS_ORIGINS=["https://lifora.onrender.com","http://localhost:5173"]

# API Documentation Control
ENABLE_DOCS=false

# SMTP / Production Email Verification & Password Reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="noreply@lifora.app"
SMTP_TLS=true

# AI Assistant Integration (Optional)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Cloud Object Storage (S3-compatible, Optional for persistent uploads)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
